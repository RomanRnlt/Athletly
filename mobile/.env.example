# Override the API base URL. Used at build time by Expo (EXPO_PUBLIC_*).
# Auto-discovered from Metro host on simulator + same-Wifi device, so
# this is only needed for tunnel mode or a deployed backend.
EXPO_PUBLIC_API_URL=

# Supabase project. URL + anon key are NOT secrets (anon key is rate-limited
# and RLS-bound). Both must be set for sign-in to work.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
