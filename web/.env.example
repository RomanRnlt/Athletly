# Web env vars mirror the mobile EXPO_PUBLIC_* names, renamed to NEXT_PUBLIC_*.

# API base URL. The web app talks to the SAME backend as the mobile app
# (services/api). Default for local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project. URL + anon key are NOT secrets (anon key is rate-limited
# and RLS-bound). Both must be set for sign-in to work. Use the same project
# the mobile app uses.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
