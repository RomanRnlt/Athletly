# LLM provider keys (use only what your chosen model needs)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default chat model. litellm-compatible string.
# Examples:
#   anthropic/claude-sonnet-4-5
#   gemini/gemini-2.5-flash
#   gemini/gemini-2.0-flash
ATHLETLY_CHAT_MODEL=anthropic/claude-sonnet-4-5

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# CORS - comma-separated, leave * for dev
CORS_ORIGINS=*
