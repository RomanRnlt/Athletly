# Supabase project credentials.
# URL and ANON_KEY are public (anon ships in the mobile binary too).
# SERVICE_ROLE_KEY bypasses RLS - keep server-side only.
# JWT verification uses the project's JWKS endpoint (ES256), no shared
# secret needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web search is provided by Anthropic's native server-side tool when the
# chat model is Anthropic. Cost: ~$10 per 1000 searches on top of token
# usage, no separate API key needed. When ATHLETLY_CHAT_MODEL is switched
# to a non-Anthropic provider, web search is disabled until we wire a
# fallback (e.g. Tavily or Brave).

# Default chat model. Any litellm-compatible string works:
#   anthropic/claude-sonnet-4-5
#   gemini/gemini-2.5-flash
ATHLETLY_CHAT_MODEL=anthropic/claude-sonnet-4-5

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=*
